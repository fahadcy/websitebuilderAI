PORT=3000
SESSION_SECRET=change-me
BUILDER_ADMIN_EMAIL=admin@example.com
BUILDER_ADMIN_PASSWORD=admin123

# Optional OpenAI generation. Leave empty to use the local fallback generator.
OPENAI_API_KEY=
# Text model for briefs/content/design tokens. gpt-5 / o-series models only accept the
# default temperature; the client detects this automatically.
OPENAI_TEXT_MODEL=gpt-4o
# Optional: sampling temperature for models that support it (default 0.65).
OPENAI_TEXT_TEMPERATURE=
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_RETRIES=2

# Reverse proxy (Render, Railway, Nginx...). Defaults to 1 hop in production.
TRUST_PROXY=
# Website generations allowed per IP per hour.
GENERATION_LIMIT_PER_HOUR=5

# Optional MySQL mirror for generated-site records, Teach Builder feedback,
# reporting views, and reinforcement/fine-tuning data.
# Use either BUILDER_MYSQL_URL or the host/database fields below.
# Example: mysql://user:password@localhost:3306/website_builder
BUILDER_MYSQL_URL=
BUILDER_MYSQL_HOST=
BUILDER_MYSQL_PORT=3306
BUILDER_MYSQL_DATABASE=
BUILDER_MYSQL_USER=
BUILDER_MYSQL_PASSWORD=
BUILDER_MYSQL_CONNECTION_LIMIT=5
